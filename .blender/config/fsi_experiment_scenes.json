{
  "name": "fsi_experiment_scenes",
  "cache_root": ".blender/cache/fsi_experiment_scenes",
  "particle_render_root": ".blender/renders/fsi_experiment_particles",
  "surface_render_root": ".blender/renders/fsi_experiment_surfaces",
  "metrics_root": ".blender/renders/fsi_experiment_metrics",
  "particle_blend_root": ".blender/templates/fsi_experiment_particles",
  "surface_blend_root": ".blender/templates/fsi_experiment_surfaces",
  "record_frames": 180,
  "record_initial_frame": true,
  "axis_conversion": "newton-y-up-to-blender-z-up",
  "render": {
    "resolution": [1920, 1080],
    "fps": 60,
    "engine": "BLENDER_EEVEE_NEXT",
    "samples": 16,
    "background": [0.0, 0.0, 0.0, 1.0]
  },
  "particles": {
    "max_preview_particles": 25000,
    "radius_scale": 0.75,
    "color": [0.02, 0.78, 1.0, 1.0]
  },
  "surface": {
    "color": [0.18, 0.58, 1.0, 0.46]
  },
  "cases": [
    {
      "key": "three_sphere_buoys",
      "label": "Three sphere buoys",
      "module": "newton.examples.fsi.example_fsi_ipbf_vbd_three_sphere_buoys",
      "group": "rigid_boundary",
      "render_frames": [0, 45, 90, 150],
      "camera": {"location": [1.35, -1.72, 1.08], "target": [0.0, 0.0, 0.48], "ortho_scale": 1.45}
    },
    {
      "key": "box_wall_break",
      "label": "Box wall break",
      "module": "newton.examples.fsi.example_fsi_ipbf_vbd_box_wall_break",
      "group": "rigid_boundary",
      "render_frames": [0, 55, 100, 155],
      "camera": {"location": [1.82, -2.08, 1.22], "target": [0.0, 0.0, 0.42], "ortho_scale": 1.90}
    },
    {
      "key": "moving_wall_float_box",
      "label": "Moving wall float box",
      "module": "newton.examples.fsi.example_fsi_ipbf_vbd_moving_wall_float_box",
      "group": "rigid_boundary",
      "render_frames": [0, 45, 90, 150],
      "camera": {"location": [1.52, -2.02, 1.12], "target": [0.0, 0.0, 0.46], "ortho_scale": 1.60}
    },
    {
      "key": "cloth_cascade",
      "label": "Cloth cascade",
      "module": "newton.examples.fsi.example_fsi_ipbf_vbd_cloth_cascade",
      "group": "cloth_shell",
      "record_frames": 210,
      "render_frames": [0, 70, 130, 200],
      "camera": {"location": [1.60, -2.55, 1.70], "target": [0.0, 0.0, 0.70], "ortho_scale": 2.15}
    },
    {
      "key": "cloth_payload_rain",
      "label": "Cloth payload rain",
      "module": "newton.examples.fsi.example_fsi_ipbf_vbd_cloth_payload_rain",
      "group": "cloth_shell",
      "record_frames": 210,
      "render_frames": [0, 70, 130, 200],
      "camera": {"location": [1.45, -2.30, 1.55], "target": [0.0, 0.0, 0.72], "ortho_scale": 1.85}
    }
  ]
}
